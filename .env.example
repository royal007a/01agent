AGENT_PROVIDER=openai
AGENT_API_KEY=
AGENT_MODEL=
# For an OpenAI- or Claude-compatible service. Leave empty for official APIs.
AGENT_BASE_URL=

# Required by the HTTP service. Use a long random value.
AGENT_API_TOKEN=
AGENT_LISTEN_ADDR=:8080
AGENT_WORKDIR=/workspace
AGENT_RUN_DIR=/var/lib/01agent/runs

# Harness bounds and durable state.
AGENT_MAX_TURNS=32
AGENT_TOKEN_BUDGET=0
AGENT_MAX_REPEATED_CALL=3
AGENT_RUN_TIMEOUT=10m
AGENT_TOOL_TIMEOUT=30s
AGENT_MAX_PARALLEL=4
AGENT_MAX_CONCURRENT=2
AGENT_CONTEXT_TOKENS=0
AGENT_TASK_RECONCILE_INTERVAL=30s
AGENT_TASK_HEARTBEAT_TIMEOUT=2m

# Provider resilience. Only transient failures are retried.
AGENT_PROVIDER_ATTEMPTS=3
AGENT_PROVIDER_BASE_DELAY=250ms
AGENT_PROVIDER_MAX_DELAY=5s
AGENT_PROVIDER_SPACING=0s
AGENT_PROVIDER_CONCURRENCY=4

# A real provider probe is cached for this interval.
AGENT_READINESS_TTL=5m
AGENT_READINESS_TIMEOUT=10s

# Registers write_file, edit_file, and bash. Requests still need approved_tools.
AGENT_ENABLE_DANGEROUS_TOOLS=false
